#!/usr/bin/env bash
# 把 git HEAD 从 detached 挂回分支（jj colocated 仓库里，jj 会把 HEAD 指到 @ 的父提交）。
#
# 用法:
#   git-attach            # HEAD 的提交上有分支 → 切过去
#   git-attach main       # 指定分支（要求 tip == HEAD）
#   git-attach -s main    # 先把 main 移到 HEAD，再切过去
#   git-attach -f         # follow: main 是 HEAD 祖先时 fast-forward 到 HEAD 再挂
#   git-attach -q         # 静默模式（给 shell 钩子用）
#
# 只在「分支 tip == HEAD」时才 switch —— 此时 git 不动工作树，jj 的 @ 完全不受影响。
set -euo pipefail

quiet=0 follow=0 set_to=""
while (($#)); do
  case "$1" in
    -q|--quiet) quiet=1 ;;
    -f|--follow) follow=1 ;;
    -s|--set) shift; set_to="${1:-}"; [[ -n "$set_to" ]] || { echo "-s 需要一个分支名" >&2; exit 2; } ;;
    -h|--help) sed -n '2,11p' "$0"; exit 0 ;;
    --) shift; break ;;
    -*) echo "未知参数: $1" >&2; exit 2 ;;
    *) set_to="$1" ;;
  esac
  shift
done

say() { (( quiet )) || printf '%s\n' "$*"; }
warn() { (( quiet )) || printf '%s\n' "$*" >&2; }
short() { cut -c1-12; }

git rev-parse --git-dir >/dev/null 2>&1 || { warn "不是 git 仓库"; exit 1; }
head="$(git rev-parse HEAD)"
top="$(git rev-parse --show-toplevel)"
# follow 只在 jj colocated 仓库里生效：普通 git 仓库里主动 detach 是用户有意为之
(( follow )) && [[ -d "$top/.jj" ]] || follow=0

current="$(git symbolic-ref -q --short HEAD || true)"
if [[ -n "$current" ]]; then
  say "HEAD 已在分支 $current（$(printf '%s' "$head" | short)）"
  exit 0
fi

branch_tip() { git rev-parse --verify --quiet "refs/heads/$1" 2>/dev/null || true; }
is_ancestor() { git merge-base --is-ancestor "refs/heads/$1" "$head" 2>/dev/null; }

move_branch() {
  if [[ -d "$top/.jj" ]] && command -v jj >/dev/null 2>&1; then
    jj bookmark set "$1" -r "$head" >/dev/null 2>&1 && return 0
  fi
  git branch -f "$1" "$head"
}

target=""

if [[ -n "$set_to" ]]; then
  # 显式指定：允许直接把分支推到 HEAD
  [[ -n "$(branch_tip "$set_to")" ]] || { warn "分支 $set_to 不存在"; exit 3; }
  if [[ "$(branch_tip "$set_to")" != "$head" ]]; then
    move_branch "$set_to" || { warn "移动分支 $set_to 失败"; exit 3; }
    say "分支 $set_to -> $(printf '%s' "$head" | short)"
  fi
  target="$set_to"
else
  # 1) 常见主分支优先
  for b in main master trunk; do
    if [[ "$(branch_tip "$b")" == "$head" ]]; then
      target="$b"
      break
    fi
  done
  # 2) 其它指向 HEAD 的分支
  if [[ -z "$target" ]]; then
    while IFS= read -r b; do
      [[ -n "$b" ]] || continue
      case "$b" in main|master|trunk) continue ;; esac
      target="$b"
      break
    done < <(git for-each-ref --points-at "$head" --format='%(refname:short)' refs/heads)
  fi
  # 3) follow：主分支是 HEAD 的祖先（jj 提交后的常态）→ fast-forward 再挂
  if [[ -z "$target" ]] && (( follow )); then
    for b in main master trunk; do
      [[ -n "$(branch_tip "$b")" ]] || continue
      is_ancestor "$b" || continue
      move_branch "$b" || continue
      say "分支 $b -> $(printf '%s' "$head" | short)"
      target="$b"
      break
    done
  fi
fi

if [[ -z "$target" ]]; then
  warn "没有可挂的分支：HEAD $(printf '%s' "$head" | short) 不在任何分支 tip 上，也不在 main 之后。"
  warn "看看发生了什么：jj log -r 'all()' | head；或手动对齐：git-attach -s <branch>"
  exit 3
fi

if [[ "$(branch_tip "$target")" != "$head" ]]; then
  warn "分支 $target 的 tip 与 HEAD 不一致，拒绝切换（会改动 jj 的工作副本）"
  exit 3
fi

if (( quiet )); then
  git switch "$target" >/dev/null 2>&1 || { warn "切换到 $target 失败"; exit 3; }
else
  git switch "$target"
fi
say "HEAD -> $target"
