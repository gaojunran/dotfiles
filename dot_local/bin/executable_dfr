#!/usr/bin/env -S usage exec bun
//USAGE about "Diff between the origin and git remotes for a bookmark."
//USAGE arg "[bookmark]" help="Bookmark to diff between origin and git. If omitted, uses the nearest bookmark reachable from @."

import { $ } from "bun";

const [arg] = process.argv.slice(2);

const bookmark = arg ?? (
  await $`jj log -r 'heads(::@ & bookmarks())' -n 1 -T 'if(local_bookmarks, local_bookmarks.first().name(), "")' --no-pager -G`.text()
).trim();

if (!bookmark) {
  throw new Error("No bookmark reachable from @");
}

await $`jj interdiff -f ${`${bookmark}@origin`} -t ${`${bookmark}@git`}`;
