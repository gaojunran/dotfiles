#!/usr/bin/env -S uv run --script

# /// script
# requires-python = ">=3.13"
# dependencies = [
#     "python-dateutil",
# ]
# ///

import datetime
import json
import re
import subprocess
import sys

from dateutil import parser as dateparser


def get_emails():
    """获取邮件列表 JSON 数据"""
    result = subprocess.run(
        ["himalaya", "--output", "json"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        sys.exit(1)
    return json.loads(result.stdout)


def filter_recent_emails(emails, minutes=1):
    """过滤出 minutes 分钟内的邮件"""
    now = datetime.datetime.now(datetime.timezone.utc)
    recent = []
    for mail in emails:
        mail_time = dateparser.parse(mail["date"])
        delta = now - mail_time.astimezone(datetime.timezone.utc)
        if delta.total_seconds() <= minutes * 60:
            recent.append(mail)
    return sorted(recent, key=lambda m: dateparser.parse(m["date"]), reverse=True)


def get_email_body(email_id):
    """获取指定邮件 ID 的正文"""
    result = subprocess.run(
        ["himalaya", "message", "read", email_id, "--no-headers"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        sys.exit(1)
    return result.stdout


def extract_verification_code(text):
    """
    匹配 4 位或 6 位验证码：
    - 前后不是数字
    - 数字后面不能直接跟减号（排除年份 2025- 这种）
    """
    match = re.search(r"(?<!\d)(\d{4}|\d{6})(?!-)(?!\d)", text)
    return match.group(0) if match else None


def main():
    emails = get_emails()
    recent_emails = filter_recent_emails(emails, minutes=1)
    if not recent_emails:
        sys.exit(0)

    latest_email = recent_emails[0]
    body = get_email_body(latest_email["id"])
    code = extract_verification_code(body)

    if code:
        print(code)


if __name__ == "__main__":
    main()
