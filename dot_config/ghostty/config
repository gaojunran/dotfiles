# Use nushell in homebrew folder.
command = "/opt/homebrew/bin/fish"

# Font
font-family = "JetBrains Mono"
font-family = "Hei Regular" # fallback font
font-size = 18

# Toggle Quick Terminal by Hyper + z (It's recommended to re-bind to capslock!)
keybind = global:cmd+opt+ctrl+z=toggle_quick_terminal

quick-terminal-position = right

background-opacity = 0.85

background-blur = true
