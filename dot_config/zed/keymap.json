// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  // 绑定 CMD + R：查找全部引用
  {
    "context": "Editor",
    "bindings": {
      "cmd-r": "editor::FindAllReferences",
    },
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-shift-f12": "editor::FindAllReferences",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-r": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-g": "git_panel::ToggleFocus",
    },
  },
  // CMD + H ：查找上一个引用
  {
    "unbind": {
      "cmd-h": "zed::Hide",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "cmd-h": "search::SelectPreviousMatch",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "cmd-shift-g": "search::SelectPreviousMatch",
    },
  },
  {
    "context": "FileFinder || FileFinder > Picker > Editor || FileFinder > Picker > menu",
    "unbind": {
      "cmd-h": "pane::SplitLeft",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
    },
  },
  {
    "bindings": {
      "cmd-shift-space": "text_finder::Toggle"
    }
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "bindings": {
      "cmd-]": "editor::GoToHunk"
    }
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "unbind": {
      "cmd-f8": "editor::GoToHunk"
    }
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "bindings": {
      "cmd-[": "editor::GoToPreviousHunk"
    }
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "unbind": {
      "cmd-shift-f8": "editor::GoToPreviousHunk"
    }
  },
  {
    "bindings": {
      "alt-tab": "agents_sidebar::ToggleThreadSwitcher"
    }
  },
  {
    "bindings": {
      "ctrl-space": "file_finder::Toggle"
    }
  }
]
