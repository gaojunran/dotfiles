      },
    },
    "JavaScript": {
      "formatter": [],
      "format_on_save": "on",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
      },
    },
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "model": "astra/glm_5d2_fp8_code",
      },
      "type": "registry",
    },
  },
  "terminal": {
    "shell": {
      "program": "/opt/homebrew/bin/fish",
