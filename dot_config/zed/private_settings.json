  // FIXME: 等 zed 支持了仅搜索排除，需要再改下
  "file_scan_exclusions": [
    "/.git",
    "/.svn",
    "/.hg",
    "/.jj",
    "/.sl",
    "/.repo",
    "/CVS",
    "/.DS_Store",
    "/Thumbs.db",
    "/.classpath",
    "/.settings",
    "/openspec",
    "/openspec/",
    "/specs",
    "/specs/",
  ],
  "project_panel": {
    "starts_open": true,
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "edit_predictions": {
    "provider": "copilot"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "icon_theme": "Catppuccin Latte",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Vitesse Refined Dark",
  },
  "languages": {
    "TypeScript": {
      "formatter": [],
      "format_on_save": "on",
      "code_actions_on_format": {
