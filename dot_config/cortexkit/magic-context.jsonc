{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  // 本会话常驻 home 目录工作，给 home 会话独立项目记忆
  "allow_home_project": true,
  "historian": {
    
    "opencode": {"model":"astra/deepseek_v4_flash_code/max","fallback_models": ["venus/deepseek-v4-flash-official"]},"pi": {"model":"astra/deepseek_v4_flash_code/max","fallback_models": ["venus/deepseek-v4-flash-official"]}
  },
  "dreamer": {
    "opencode": {"model":"astra/deepseek_v4_flash_code/max","fallback_models": ["venus/deepseek-v4-flash-official"]},"pi": {"model":"astra/deepseek_v4_flash_code/max","fallback_models": ["venus/deepseek-v4-flash-official"]}
  },
  "sidekick": {
    "disable": true
  },
  // 默认 300s，提高一些
  "historian_timeout_ms": 600000,
  // 给一些 1M 模型一个强制的 compact 上界
  "execute_threshold_tokens": { "default": 150000 }
}
