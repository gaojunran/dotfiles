    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "codebuddy": {
            "name": "CodeBuddy",
            "npm": "@ai-sdk/openai-compatible",
            "api": "https://copilot.tencent.com/v2",
            "env": [
                "CODEBUDDY_ACCESS_TOKEN"
            ],
            "options": {
                "apiKey": "{env:CODEBUDDY_ACCESS_TOKEN}",
                "headers": {
                    "X-User-Id": "{env:CODEBUDDY_USER_ID}",
                    "X-Enterprise-Id": "{env:CODEBUDDY_ENTERPRISE_ID}",
                    "X-Tenant-Id": "{env:CODEBUDDY_ENTERPRISE_ID}",
                    "X-Domain": "{env:CODEBUDDY_DOMAIN}"
