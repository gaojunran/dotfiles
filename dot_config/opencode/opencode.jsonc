{
  // "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "oh-my-opencode-slim",
    "@cortexkit/aft-opencode",
    "@cortexkit/opencode-magic-context",
    "opencode-git-add",
    {
      "package": "opencode-codebuddy-auth-fixed@latest",
      "options": {
        "extraModels": [
        { "id": "claude-opus-5.5", "name": "Claude-Opus-5.5", "context": 400000, "output": 128000, "tool_call": true, "attachment": true },
        { "id": "gpt-6-sol", "name": "GPT-6-Sol", "context": 1050000, "output": 128000, "tool_call": true, "attachment": true },
        { "id": "gpt-6.1-sol", "name": "GPT-6.1-Sol", "context": 1050000, "output": 128000, "tool_call": true, "attachment": true },
        { "id": "gpt-6.1-luna", "name": "GPT-6.1-Luna", "context": 1050000, "output": 128000, "tool_call": true, "attachment": true },
        ]
      }
    }  // https://github.com/gaojunran/opencode-codebuddy-auth
  ],
  "default_agent": "orchestrator",
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "build": {
      "disabled": false  // 特意保留，插件如果挂了作为备用
    },
    "plan": {
      "disabled": true
    }
  },
  "compaction": {
    "auto": false  // v1 的 prune 在 v2 无等价物，已移除
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "deny" }
  ],
  "enabled_providers": [
    "cctq",
    "venus",
    "astra",
    "codebuddy"
  ],
  "providers": {
    "cctq": {
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "https://www.cctq.ai/v1",
        "apiKey": "{env:CCTQ_API_KEY}",
        "setCacheKey": true
      },
      "models": {
        "gpt-6-sol": {
          "name": "gpt-6-sol",
          "limit": { "context": 200000, "output": 96000 }
        },
        "gpt-6.1-sol": {
          "name": "gpt-6.1-sol",
          "limit": { "context": 200000, "output": 96000 }
        },
        "gpt-6.1-luna": {
          "name": "gpt-6.1-luna",
          "limit": { "context": 200000, "output": 96000 }
        },
        "gpt-6-luna": {
          "name": "gpt-6-luna",
          "limit": { "context": 200000, "output": 96000 }
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "limit": { "context": 200000, "output": 96000 }
        }
      }
    },
    "astra": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "astra",
      "settings": {
        "baseURL": "{env:ASTRA_BASE_URL}",
        "apiKey": "{env:ASTRA_TOKEN}",
        "headerTimeout": 30000,
        "chunkTimeout": 30000
      },
      "models": {
        "deepseek_v4_flash_code/max": {
          "name": "deepseek_v4_flash_code/max",
          "limit": { "context": 800000, "output": 96000 } // 声明大一点，防止 magic-context 报错
        },
        "GLM-5.3-astra": {
          "name": "GLM-5.3-astra",
          "limit": { "context": 200000, "output": 96000 }
        },
        "DeepSeek-V4.1-Flash-astra": {
          "name": "DeepSeek-V4.1-Flash-astra",
          "limit": { "context": 200000, "output": 96000 }
        },
        "MiMo-V2.6-Pro-RL-astra": {
          "name": "MiMo-V2.6-Pro-RL-astra",
          "limit": { "context": 200000, "output": 96000 }
        }
      }
    },
    "venus": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "venus",
      "settings": {
        "baseURL": "http://v2.open.venus.oa.com/llmproxy",
        "apiKey": "{env:VENUS_TOKEN}",
        "headerTimeout": 30000,
        "chunkTimeout": 30000
      },
      "headers": {
        "Venus-Sticky-Routing": "token"
      },
      "models": {
        "deepseek-v4-flash-official": {
          "name": "deepseek-v4-flash-official",
          "disabled": false,
          "limit": { "context": 800000, "output": 96000 }
        },
        "glm-5.3-external": {
          "name": "glm-5.3-external",
          "limit": { "context": 300000, "output": 96000 }
        },
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": { "context": 800000, "output": 96000 }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "anysearch": {
        "type": "remote",
        "url": "https://api.anysearch.com/mcp",
        "oauth": false,  // v2 中 remote MCP 默认走 OAuth，header 认证直连必须显式关闭
        "headers": {
          "Authorization": "Bearer {env:ANYSEARCH_API_KEY}",
          "X-Anysearch-Client": "mcp/1.0.0"
        }
      }
    }
  }
}
