{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim",
    "@cortexkit/opencode-magic-context@0.38.0",
    "opencode-codebuddy-auth-fixed",
    "opencode-truncate-lsp-diagnostics",
    "opencode-git-add"
  ],
  "default_agent": "orchestrator",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "lsp": true,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "permission": {
    "*": {
      "*": "allow"
    }
  },
  "enabled_providers": ["cctq", "venus", "astra", "codebuddy"],
  "provider": {
    "cctq": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://www.cctq.ai/v1",
        "apiKey": "{env:CCTQ_API_KEY}",
        "setCacheKey": true
      },
      "models": {
        "gpt-5.6-terra": { "name": "gpt-5.6-terra", "reasoning": true, "limit": { "context": 200000, "output": 96000 }, "options": {} },
        "gpt-5.6-sol": { "name": "gpt-5.6-sol", "reasoning": true, "options": {} }
      }
    },
    "astra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "astra",
      "options": {
        "baseURL": "{env:ASTRA_BASE_URL}",
        "apiKey": "{env:ASTRA_TOKEN}"
      },
      "models": {
        "kimi_k2d7_code/thinking": { "name": "kimi_k2d7_code/thinking", "limit": { "context": 200000, "output": 96000 } },
        "glm_5d2_fp8_code": { "name": "glm_5d2_fp8_code", "limit": { "context": 170000, "output": 96000 } },
        "minimax_m3_code/infer": { "name": "minimax_m3_code/infer", "limit": { "context": 80000, "output": 96000 } },
        "deepseek_v4_flash_code/max": { "name": "deepseek_v4_flash_code/max", "limit": { "context": 200000, "output": 96000 } },
        "deepseek_v4_pro_code/max": { "name": "deepseek_v4_pro_code/max", "limit": { "context": 200000, "output": 96000 } },
        "kimi_k3_astra": { "name": "kimi_k3_astra", "limit": { "context": 170000, "output": 96000 } },
        "GLM-5.3-Flash-astra": { "name": "GLM-5.3-Flash-astra", "limit": { "context": 200000, "output": 96000 } },
      }
    },
    "venus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "venus",
      "options": {
        "baseURL": "http://v2.open.venus.oa.com/llmproxy",
        "apiKey": "{env:VENUS_TOKEN}",
        "headers": {
          "Venus-Sticky-Routing": "token"
        }
      },
      "models": {
        "deepseek-v4-flash-official": { "name": "deepseek-v4-flash-official", "limit": { "context": 300000, "output": 96000 } },
        "deepseek-v4-pro-official": { "name": "deepseek-v4-pro-official", "limit": { "context": 300000, "output": 96000 } },
        "kimi-k2.7-code-external": { "name": "kimi-k2.7-code-external", "limit": { "context": 200000, "output": 96000 } },
        "glm-5.2-external": { "name": "glm-5.2-external", "limit": { "context": 300000, "output": 96000 } },
        "glm-5.3-external": { "name": "glm-5.3-external", "limit": { "context": 300000, "output": 96000 } },
        "minimax-m3-external": { "name": "minimax-m3-external", "limit": { "context": 800000, "output": 96000 } }
      }
    },
  }
}
