{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim",
    "@cortexkit/opencode-magic-context",
    "@cortexkit/aft-opencode@latest",
    "opencode-codebuddy-auth-fixed", // https://github.com/gaojunran/opencode-codebuddy-auth-fixed
    "opencode-git-add", // https://github.com/gaojunran/opencode-git-add
  ],
  "default_agent": "orchestrator",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "lsp": true,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "permission": {
    "*": {
      "*": "allow"
    }
  },
  "enabled_providers": [
    "cctq",
    "venus",
    "astra",
    "codebuddy"
  ],
  "provider": {
    "cctq": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://www.cctq.ai/v1",
        "apiKey": "{env:CCTQ_API_KEY}",
        "setCacheKey": true
      },
      "models": {
        "gpt-5.6-terra": {
          "name": "gpt-5.6-terra",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 96000
          },
          "options": {}
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "reasoning": true,
          "options": {}
        }
      }
    },
    "astra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "astra",
      "options": {
        "baseURL": "{env:ASTRA_BASE_URL}",
        "apiKey": "{env:ASTRA_TOKEN}"
      },
      "models": {
        "glm_5d2_fp8_code": {
          "name": "glm_5d2_fp8_code",
          "limit": {
            "context": 170000,
            "output": 96000
          }
        },
        "deepseek_v4_flash_code/max": {
          "name": "deepseek_v4_flash_code/max",
          "limit": {
            "context": 200000,
            "output": 96000
          }
        },
        "deepseek_v4_pro_code/max": {
          "name": "deepseek_v4_pro_code/max",
          "limit": {
            "context": 200000,
            "output": 96000
          }
        },
        "kimi_k3_astra": {
          "name": "kimi_k3_astra",
          "limit": {
            "context": 170000,
            "output": 96000
          }
        },
        "GLM-5.3-Flash-astra": {
          "name": "GLM-5.3-Flash-astra",
          "limit": {
            "context": 200000,
            "output": 96000
          }
        },
        "GLM-5.3-astra": {
          "name": "GLM-5.3-astra",
          "limit": {
            "context": 200000,
            "output": 96000
          }
        }
      }
    },
    "venus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "venus",
      "options": {
        "baseURL": "http://v2.open.venus.oa.com/llmproxy",
        "apiKey": "{env:VENUS_TOKEN}",
        "headers": {
          "Venus-Sticky-Routing": "token"
        }
      },
      "models": {
        "deepseek-v4-flash-official": {
          "name": "deepseek-v4-flash-official",
          "limit": {
            "context": 300000,
            "output": 96000
          }
        },
        "deepseek-v4-pro-official": {
          "name": "deepseek-v4-pro-official",
          "limit": {
            "context": 300000,
            "output": 96000
          }
        },
        "glm-5.3-external": {
          "name": "glm-5.3-external",
          "limit": {
            "context": 300000,
            "output": 96000
          }
        },
      }
    }
  }
}
