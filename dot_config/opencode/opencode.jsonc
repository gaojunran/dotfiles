{
  "plugin": ["oh-my-openagent@latest"],
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
  },
  "permission": {
    "*": {
      "*": "allow",
    },
  },
  "mcp": {
    "wecloud_mcp": {
      "type": "remote",
      "url": "https://prod.mcp.it.woa.com/paasfront_cloud_wedesign_woa_com/mcp",
      "enabled": true,
      "oauth": {},
    },
  },
  "provider": {
    "venus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "venus",
      "options": {
        "baseURL": "http://v2.open.venus.oa.com/llmproxy",
        "apiKey": "{env:VENUS_TOKEN}",
      },
      "models": {
        "glm-5.1": {
          "name": "glm-5.1",
          "limit": {
            "context": 99072,
            "output": 32000,
          },
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "limit": {
            "context": 99072,
            "output": 32000,
          },
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "limit": {
            "context": 99072,
            "output": 32000,
          },
        },
      },
    },
  },
}
