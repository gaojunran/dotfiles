{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-opencode-slim"],
  "agent": {
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "build": {
      "disable": true,
    },
    "plan": {
      "disable": true,
    },
  },
  "lsp": true,
  "compaction": {
    "auto": true,
  },
  "permission": {
    "*": {
      "*": "allow",
    },
  },
  "mcp": {
    "wecloud_mcp": {
      "type": "remote",
      "url": "https://prod.mcp.it.woa.com/paasfront_cloud_wedesign_woa_com/mcp",
      "enabled": true,
      "oauth": {},
    },
    "push_lib": {
      "type": "remote",
      "url": "https://wxlib-push.mcp.it.woa.com",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:PUSH_LIB_TOKEN}",
      },
    },
  },
  "provider": {
    "cctq": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://www.cctq.ai/v1",
        "apiKey": "{env:CCTQ_API_KEY}",
        "setCacheKey": true,
      },
      "models": {
        "gpt-5.5": {
          "name": "gpt-5.5",
          "reasoning": true,
          "options": {
            // "reasoningEffort": "xhigh",
          },
        },
      },
    },
    "astra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "astra",
      "options": {
        "baseURL": "{env:ASTRA_BASE_URL}",
        "apiKey": "{env:ASTRA_TOKEN}",
      },
      "models": {
        "kimi_k2d7_code/thinking": {
          "name": "kimi_k2d7_code/thinking",
          "limit": {
            "context": 200000,
            "output": 32000,
          },
        },
        "glm_5d2_fp8_code": {
          "name": "glm_5d2_fp8_code",
          "limit": {
            "context": 170000,
            "output": 32000,
          },
        },
        "minimax_m3_code/infer": {
          "name": "minimax_m3_code/infer",
          "limit": {
            "context": 170000,
            "output": 32000,
          },
        },
      },
    },
    "venus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "venus",
      "options": {
        "baseURL": "http://v2.open.venus.oa.com/llmproxy",
        "apiKey": "{env:VENUS_TOKEN}",
      },
      "models": {
        "kimi-k2.7-code-external": {
          "name": "kimi-k2.7-code-external",
          "limit": {
            "context": 200000,
            "output": 32000,
          },
        },
        "glm-5.2-external": {
          "name": "glm-5.2-external",
          "limit": {
            "context": 800000,
            "output": 32000,
          },
        },
        "deepseek-v4-pro-external": {
          "name": "deepseek-v4-pro-external",
          "limit": {
            "context": 800000,
            "output": 32000,
          },
        },
        "deepseek-v4-flash-external": {
          "name": "deepseek-v4-flash-external",
          "limit": {
            "context": 800000,
            "output": 32000,
          },
        },
        "minimax-m3-external": {
          "name": "minimax-m3-external",
          "limit": {
            "context": 800000,
            "output": 32000,
          },
        },
      },
    },
  },
}
