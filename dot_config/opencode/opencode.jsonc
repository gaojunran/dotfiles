{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-opencode-slim",
    "@cortexkit/opencode-magic-context",
    "@cortexkit/aft-opencode@latest",
    "opencode-codebuddy-auth-fixed", // https://github.com/gaojunran/opencode-codebuddy-auth-fixed
    "opencode-git-add", // https://github.com/gaojunran/opencode-git-add
  ],
  "default_agent": "orchestrator",
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "build": {
      "disable": false  // 特意保留，插件如果挂了作为备用
    },
    "plan": {
      "disable": true
    }
  },
  "lsp": true,
  "compaction": {
    "auto": false,
    "prune": false
  },
  "permission": {
    "*": {
      "*": "allow"
    },
    "websearch": "deny"
  },
  "enabled_providers": [
    "cctq",
    "cctq-cn",
    "venus",
    "astra",
    "codebuddy"
  ],
  "provider": {
    "cctq": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://www.cctq.ai/v1",
        "apiKey": "{env:CCTQ_API_KEY}",
        "setCacheKey": true
      },
      "models": {
        "gpt-6-sol": {
          "name": "gpt-6-sol",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 96000
          },
          "options": {}
        },
        "gpt-6-luna": {
          "name": "gpt-6-luna",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 96000
          },
          "options": {}
        }
      }
    },
    "cctq-cn": {
      "npm": "@ai-sdk/openai",
      "options": {
        "baseURL": "https://www.cctq.ai/v1",
        "apiKey": "{env:CCTQ_CN_API_KEY}",
        "setCacheKey": true
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 96000
          },
          "options": {}
        },
        "glm-5.3": {
          "name": "glm-5.3",
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 96000
          },
          "options": {}
        }
      }
    },
    "astra": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "astra",
      "options": {
        "baseURL": "{env:ASTRA_BASE_URL}",
        "apiKey": "{env:ASTRA_TOKEN}",
        "headerTimeout": 30000,
        "chunkTimeout": 30000
      },
      "models": {
        "deepseek_v4_flash_code/max": {
          "name": "deepseek_v4_flash_code/max",
          "limit": {
            "context": 200000,
            "output": 96000
          }
        },
        "kimi_k3_astra": {
          "name": "kimi_k3_astra",
          "limit": {
            "context": 200000,
            "output": 96000
          }
        },
        "GLM-5.3-astra": {
          "name": "GLM-5.3-astra",
          "limit": {
            "context": 200000,
            "output": 96000
          }
        },
        "DeepSeek-V4.1-Flash-astra": {
          "name": "DeepSeek-V4.1-Flash-astra",
          "limit": {
            "context": 200000,
            "output": 96000
          }
        },
        "MiMo-V2.6-Pro-RL-astra": {
          "name": "MiMo-V2.6-Pro-RL-astra",
          "limit": {
            "context": 200000,
            "output": 96000
          }
        },
      }
    },
    "venus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "venus",
      "options": {
        "baseURL": "http://v2.open.venus.oa.com/llmproxy",
        "apiKey": "{env:VENUS_TOKEN}",
        "headers": {
          "Venus-Sticky-Routing": "token"
        },
        "headerTimeout": 30000,
        "chunkTimeout": 30000
      },
      "models": {
        "deepseek-v4-flash-official": {
          "name": "deepseek-v4-flash-official",
          "limit": {
            "context": 300000,
            "output": 96000
          }
        },
        "glm-5.3-external": {
          "name": "glm-5.3-external",
          "limit": {
            "context": 300000,
            "output": 96000
          }
        },
      }
    }
  },
  "mcp": {
    "anysearch": {
      "type": "remote",
      "url": "https://api.anysearch.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:ANYSEARCH_API_KEY}",
        "X-Anysearch-Client": "mcp/1.0.0"
      }
    }
  }
}
