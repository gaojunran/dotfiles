{
  // opencode.ai/config.json 仍是 v1 schema（不含 agents/plugins/providers 等 v2 字段，会误报）；
  // "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "oh-my-opencode-slim",
    "@cortexkit/aft-opencode",
    "@cortexkit/opencode-magic-context",
    // extraModels：整个替换插件内置 EXTRA_MODELS 清单（/v3/config 目录未暴露、后端实测可用的模型）。
    // 2026-09 实测 copilot.tencent.com/v2：gpt-6-sol / claude-opus-5.5 流式可调通；gpt-6-terra 返回 11102 未接入。
    // 目录元数据缺失，上下文窗口为估值；若后续 /v3/config 下发同 id 模型，目录优先不覆盖。
    {
      "package": "opencode-codebuddy-auth-fixed@latest",
      "options": {
        "extraModels": [
        { "id": "claude-opus-5.5", "name": "Claude-Opus-5.5", "context": 400000, "output": 128000, "tool_call": true, "attachment": true },
        { "id": "gpt-6-sol", "name": "GPT-6-Sol", "context": 1050000, "output": 128000, "tool_call": true, "attachment": true },
        { "id": "claude-sonnet-4.6", "name": "Claude-Sonnet-4.6", "context": 176000, "output": 24000, "tool_call": true, "attachment": true },
        { "id": "claude-sonnet-5-1m", "name": "Claude-Sonnet-5-1M", "context": 1000000, "output": 128000, "tool_call": true, "attachment": true },
        { "id": "claude-sonnet-5", "name": "Claude-Sonnet-5", "context": 200000, "output": 64000, "tool_call": true, "attachment": true },
        { "id": "claude-sonnet-4.6-1m", "name": "Claude-Sonnet-4.6-1M", "context": 1000000, "output": 24000, "tool_call": true, "attachment": true },
        { "id": "claude-opus-4.8", "name": "Claude-Opus-4.8", "context": 176000, "output": 64000, "tool_call": true, "attachment": true },
        { "id": "claude-opus-4.8-1m", "name": "Claude-Opus-4.8-1M", "context": 1000000, "output": 128000, "tool_call": true, "attachment": true },
        { "id": "claude-opus-4.7", "name": "Claude-Opus-4.7", "context": 176000, "output": 64000, "tool_call": true, "attachment": true },
        { "id": "claude-opus-4.7-1m", "name": "Claude-Opus-4.7-1M", "context": 1000000, "output": 128000, "tool_call": true, "attachment": true },
        { "id": "claude-opus-4.6", "name": "Claude-Opus-4.6", "context": 176000, "output": 24000, "tool_call": true, "attachment": true },
        { "id": "claude-opus-4.6-1m", "name": "Claude-Opus-4.6-1M", "context": 1000000, "output": 64000, "tool_call": true, "attachment": true },
        { "id": "claude-haiku-4.5", "name": "Claude-Haiku-4.5", "context": 176000, "output": 24000, "tool_call": true, "attachment": true },
        { "id": "gpt-5.6-sol", "name": "GPT-5.6-Sol", "context": 1050000, "output": 128000, "tool_call": true, "attachment": true },
        { "id": "gpt-5.6-terra", "name": "GPT-5.6-Terra", "context": 1050000, "output": 128000, "tool_call": true, "attachment": true },
        { "id": "gpt-5.6-luna", "name": "GPT-5.6-Luna", "context": 1050000, "output": 128000, "tool_call": true, "attachment": true }
        ]
      }
    }  // https://github.com/gaojunran/opencode-codebuddy-auth
  ],
  "default_agent": "orchestrator",
  "agents": {
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "build": {
      "disabled": false  // 特意保留，插件如果挂了作为备用
    },
    "plan": {
      "disabled": true
    }
  },
  // 不再配置 lsp：v2 已移除 LSP 运行时，诊断由 aft 插件承担
  "compaction": {
    "auto": false  // v1 的 prune 在 v2 无等价物，已移除
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "deny" }
  ],
  "enabled_providers": [
    "cctq",
    "cctq-cn",
    "venus",
    "astra",
    "codebuddy"
  ],
  "providers": {
    "cctq": {
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "https://www.cctq.ai/v1",
        "apiKey": "{env:CCTQ_API_KEY}",
        "setCacheKey": true
      },
      "models": {
        "gpt-6-sol": {
          "name": "gpt-6-sol",
          "limit": { "context": 200000, "output": 96000 }
        },
        "gpt-6-luna": {
          "name": "gpt-6-luna",
          "limit": { "context": 200000, "output": 96000 }
        },
        "gpt-5.6-sol": {
          "name": "gpt-5.6-sol",
          "limit": { "context": 200000, "output": 96000 }
        }
      }
    },
    "cctq-cn": {
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "https://www.cctq.ai/v1",
        "apiKey": "{env:CCTQ_CN_API_KEY}",
        "setCacheKey": true
      },
      "models": {
        "deepseek-v4.1-flash": {
          "name": "deepseek-v4.1-flash",
          "limit": { "context": 200000, "output": 96000 }
        },
        "glm-5.3": {
          "name": "glm-5.3",
          "limit": { "context": 200000, "output": 96000 }
        }
      }
    },
    "astra": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "astra",
      "settings": {
        "baseURL": "{env:ASTRA_BASE_URL}",
        "apiKey": "{env:ASTRA_TOKEN}",
        "headerTimeout": 30000,
        "chunkTimeout": 30000
      },
      "models": {
        "deepseek_v4_flash_code/max": {
          "name": "deepseek_v4_flash_code/max",
          "limit": { "context": 200000, "output": 96000 }
        },
        "kimi_k3_astra": {
          "name": "kimi_k3_astra",
          "limit": { "context": 200000, "output": 96000 }
        },
        "GLM-5.3-astra": {
          "name": "GLM-5.3-astra",
          "limit": { "context": 200000, "output": 96000 }
        },
        "DeepSeek-V4.1-Flash-astra": {
          "name": "DeepSeek-V4.1-Flash-astra",
          "limit": { "context": 200000, "output": 96000 }
        },
        "MiMo-V2.6-Pro-RL-astra": {
          "name": "MiMo-V2.6-Pro-RL-astra",
          "limit": { "context": 200000, "output": 96000 }
        }
      }
    },
    "github-copilot": {
      "npm": "@ai-sdk/copilot",
      "models": {
        "claude-sonnet-5.5": { "name": "claude-sonnet-5.5", "disabled": true }
      }
    },
    "venus": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "venus",
      "settings": {
        "baseURL": "http://v2.open.venus.oa.com/llmproxy",
        "apiKey": "{env:VENUS_TOKEN}",
        "headerTimeout": 30000,
        "chunkTimeout": 30000
      },
      "headers": {
        "Venus-Sticky-Routing": "token"
      },
      "models": {
        "deepseek-v4-flash-official": {
          "name": "deepseek-v4-flash-official",
          "disabled": false,
          "limit": { "context": 300000, "output": 96000 }
        },
        "glm-5.3-external": {
          "name": "glm-5.3-external",
          "limit": { "context": 300000, "output": 96000 }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "anysearch": {
        "type": "remote",
        "url": "https://api.anysearch.com/mcp",
        "oauth": false,  // v2 中 remote MCP 默认走 OAuth，header 认证直连必须显式关闭
        "headers": {
          "Authorization": "Bearer {env:ANYSEARCH_API_KEY}",
          "X-Anysearch-Client": "mcp/1.0.0"
        }
      }
    }
  }
}
