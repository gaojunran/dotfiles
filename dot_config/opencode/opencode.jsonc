{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
  },
  "permission": {
    "*": {
      "*": "allow",
    },
  },
  "provider": {
    "venus": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "venus",
      "options": {
        "baseURL": "http://v2.open.venus.oa.com/llmproxy",
        "apiKey": "{env:VENUS_TOKEN}",
      },
      "models": {
        "glm-5.1": {
          "name": "glm-5.1",
          "limit": {
            "context": 143616,
            "output": 32768,
          },
        },
        "deepseek-v4-pro": {
          "name": "deepseek-v4-pro",
          "limit": {
            "context": 800000,
            "output": 32768,
          },
        },
        "kimi-k2.6": {
          "name": "kimi-k2.6",
          "limit": {
            "context": 193616,
            "output": 16384,
          },
        },
      },
    },
  },
}
