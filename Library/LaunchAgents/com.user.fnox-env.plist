<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.fnox-env</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>FNOX="$HOME/.local/share/mise/installs/fnox/latest/fnox"; "$FNOX" export --format env | while IFS='=' read -r k v; do case "$k" in export\ *) k="${k#export }"; v="${v#\'}"; v="${v%\'}"; launchctl setenv "$k" "$v" ;; esac; done</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/nebula</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/nebula</string>
        <key>PATH</key>
        <string>/Users/nebula/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>LimitLoadToSessionType</key>
    <array><string>Aqua</string></array>
    <key>StandardOutPath</key>
    <string>/tmp/fnox-env.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/fnox-env.err</string>
</dict>
</plist>
